{
    "easymore_output": "/path/to/forcings/easymore-outputs",
    "output_path": "/path/to/output/hypemodel",
    "timeshift": -6,
    "forcing_units": {
        "temperature": {
            "in_varname": "CaSR_v3.1_P_TT_09975",
            "in_units": "celsius",
            "out_units": "celsius"
        },
        "precipitation": {
            "in_varname": "CaSR_v3.1_A_PR0_SFC",
            "in_units": "m/hr",
            "out_units": "mm/day"
        }
    },
    "geofabric_mapping": {
