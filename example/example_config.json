            "in_varname": "COMID"
        },
        "nextDownID": {
            "in_varname": "NextDownID"
        },
        "area": {
            "in_varname": "unitarea",
            "in_units": "km^2",
            "out_units": "m^2"
        },
        "rivlen": {
            "in_varname": "new_len_km",
            "in_units": "km",
            "out_units": "m"
        }
    },
